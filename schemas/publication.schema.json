{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pubforge.dev/schemas/publication.schema.json",
  "title": "PubForge Publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "language", "content", "theme", "outputs"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "author": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ]
    },
    "language": { "type": "string", "minLength": 2 },
    "type": {
      "type": "string",
      "enum": ["report", "book", "magazine", "manual", "travel-guide", "custom"],
      "default": "custom"
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "breakBefore": {
                "type": "string",
                "enum": ["auto", "page", "left", "right", "recto", "verso"]
              }
            }
          }
        ]
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["css"],
      "properties": {
        "preset": { "type": "string" },
        "css": { "type": "string", "minLength": 1 }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["print", "epub", "webpub", "project-zip"]
      }
    }
  }
}
