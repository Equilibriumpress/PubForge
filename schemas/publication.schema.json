{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pubforge.dev/schemas/publication.schema.json",
  "title": "PubForge Publication v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "publication",
    "readingOrder",
    "theme"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "type": {
          "type": "string",
          "enum": [
            "report",
            "book",
            "magazine",
            "manual",
            "travel-guide",
            "custom"
          ]
        },
        "identifier": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rights": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "readingProgression": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ],
          "default": "ltr"
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toc": {
          "type": "boolean",
          "default": true
        },
        "tocTitle": {
          "type": "string",
          "default": "Contents"
        },
        "sectionDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 1
        },
        "landmarks": {
          "type": "boolean",
          "default": true
        },
        "pageList": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "readingOrder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "cover",
              "title-page",
              "copyright",
              "toc",
              "preface",
              "chapter",
              "appendix",
              "bibliography",
              "colophon",
              "other"
            ]
          },
          "theme": {
            "type": "string"
          },
          "breakBefore": {
            "type": "string",
            "enum": [
              "auto",
              "page",
              "left",
              "right",
              "recto",
              "verso"
            ]
          },
          "pageCounterReset": {
            "type": "integer"
          },
          "layout": {
            "type": "string",
            "enum": [
              "flow",
              "page",
              "spread"
            ]
          },
          "pageName": {
            "type": "string"
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "css"
      ],
      "properties": {
        "preset": {
          "type": "string"
        },
        "css": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mermaid": {
          "type": "boolean",
          "default": true
        },
        "syntaxHighlighting": {
          "type": "boolean",
          "default": true
        },
        "shikiTheme": {
          "type": "string",
          "default": "github-light"
        },
        "imageOptimization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxDimension": {
              "type": "integer",
              "minimum": 256
            },
            "jpegQuality": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1
            }
          }
        },
        "editorialImages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "credit": {
                "type": "string"
              },
              "decorative": {
                "type": "boolean"
              },
              "fit": {
                "type": "string",
                "enum": [
                  "cover",
                  "contain"
                ]
              },
              "focalPoint": {
                "type": "string"
              },
              "bleed": {
                "type": "string",
                "enum": [
                  "none",
                  "full",
                  "left",
                  "right"
                ]
              },
              "span": {
                "type": "string",
                "enum": [
                  "column",
                  "page",
                  "spread"
                ]
              },
              "position": {
                "type": "string",
                "enum": [
                  "inline",
                  "float-left",
                  "float-right",
                  "full-page"
                ]
              },
              "printWidthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "targetDpi": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "imagePreflight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targetDpi": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "vfm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "math": {
          "type": "boolean"
        },
        "mathRenderer": {
          "type": "string",
          "enum": [
            "mathjax",
            "mathml"
          ]
        },
        "footnote": {
          "type": "string",
          "enum": [
            "pandoc",
            "dpub",
            "gcpm"
          ]
        },
        "hardLineBreaks": {
          "type": "boolean"
        },
        "imgFigcaptionOrder": {
          "type": "string",
          "enum": [
            "img-figcaption",
            "figcaption-img"
          ]
        },
        "assignIdToFigcaption": {
          "type": "boolean"
        },
        "captionlessImagePolicy": {
          "type": "string",
          "enum": [
            "paragraph",
            "figure"
          ]
        },
        "parseFigcaptionAsInline": {
          "type": "boolean"
        },
        "rewriteRelativeHrefExtensions": {
          "type": "boolean"
        },
        "tableCell": {
          "type": "string",
          "enum": [
            "align-attribute",
            "align-class",
            "align-style"
          ]
        }
      }
    },
    "pdf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "enum": [
            "screen",
            "book",
            "press"
          ]
        },
        "size": {
          "type": "string"
        },
        "width": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "binding": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "bleed": {
          "type": "string"
        },
        "cropMarks": {
          "type": "boolean"
        },
        "cropOffset": {
          "type": "string"
        },
        "bookmarks": {
          "type": "boolean"
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "normal",
              "print",
              "high-quality"
            ]
          },
          "uniqueItems": true
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "preflight": {
              "type": "string",
              "enum": [
                "press-ready",
                "press-ready-local"
              ]
            },
            "preflightOptions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "cmyk": {
              "type": "boolean"
            },
            "outputIntent": {
              "type": "string"
            }
          }
        }
      }
    },
    "epub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reflowable": {
          "type": "boolean"
        },
        "theme": {
          "type": "string"
        },
        "themePackages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "embeddedFonts": {
          "type": "boolean"
        },
        "layout": {
          "type": "string",
          "enum": [
            "reflowable",
            "fixed"
          ]
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "orientation": {
          "type": "string",
          "enum": [
            "auto",
            "portrait",
            "landscape"
          ]
        },
        "spread": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "landscape",
            "both"
          ]
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "reflowable",
              "fixed"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "vendorProfile": {
          "type": "string",
          "enum": [
            "generic",
            "apple-books",
            "kindle",
            "kobo"
          ]
        }
      }
    },
    "webpub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "projectZip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "flow",
            "magazine"
          ]
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "gutter": {
          "type": "string"
        }
      }
    }
  }
}
